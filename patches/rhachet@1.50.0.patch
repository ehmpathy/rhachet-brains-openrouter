diff --git a/dist/domain.objects/BrainEffort.d.ts b/dist/domain.objects/BrainEffort.d.ts
new file mode 100644
index 0000000000000000000000000000000000000000..045dbcb39046473e1a66faac2670abfa8fb81aa6
--- /dev/null
+++ b/dist/domain.objects/BrainEffort.d.ts
@@ -0,0 +1,28 @@
+import type { PickOne } from 'type-fns';
+/**
+ * .what = one effort level a brain may accept
+ * .why = level sets differ per supplier and grow; three autocomplete, any string passes
+ *        through for the brain to validate against its `spec.supports.effort.levels`
+ */
+export type BrainEffortLevel = 'low' | 'medium' | 'high' | (string & {});
+/**
+ * .what = how hard a brain may think before it must answer, per ask
+ * .why = the thought cost is per ask; a level for a caller with no token figure, a
+ *        budget for a deadline-bound one
+ *
+ * .note = a bare string aliases `{ level }`
+ */
+export type BrainEffort = BrainEffortLevel | PickOne<{
+    level: BrainEffortLevel;
+    budget: {
+        tokens: number;
+    };
+}>;
+/**
+ * .what = which effort forms a brain honors
+ * .why = so a caller can branch before the call
+ */
+export type BrainSupportsEffort = {
+    levels: string[];
+    budget: boolean;
+} | null;
