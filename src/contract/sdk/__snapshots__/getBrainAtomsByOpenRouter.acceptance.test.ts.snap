exports[`getBrainAtomsByOpenRouter.acceptance given: [case10] a slug that is neither listed nor an openrouter id when: [t0] it is asked then: the refusal a human reads matches snapshot 1`] = `
"✋ ConstraintError: 'openrouter/acme' names no openrouter model.

name one of these, each with an optional /{filters} segment:
  - a tier:
      openrouter/deepseek/pro
      openrouter/deepseek/flash
      openrouter/moonshotai/pro
      openrouter/z-ai/pro
      openrouter/z-ai/flash
  - any openrouter id: openrouter/{author}/{model}, e.g. openrouter/z-ai/glm-5.3

{
  "slug": "openrouter/acme",
  "valid": [
    "openrouter/deepseek/pro",
    "openrouter/deepseek/flash",
    "openrouter/moonshotai/pro",
    "openrouter/z-ai/pro",
    "openrouter/z-ai/flash"
  ]
}"
`;

exports[`getBrainAtomsByOpenRouter.acceptance given: [case11] a key openrouter does not recognize when: [t0] the built atom is asked, live then: the refusal a human reads matches snapshot 1`] = `
