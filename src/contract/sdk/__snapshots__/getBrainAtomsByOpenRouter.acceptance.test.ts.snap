  - region=usa
  - precision=int4|int8|fp4|fp6|fp8|fp16|bf16|fp32
  - privacy=full
  - price.max={N}usd/M
  - sort=price|throughput|latency   (latency: only without floor)

{
  "word": "cheap"
}"
`;

