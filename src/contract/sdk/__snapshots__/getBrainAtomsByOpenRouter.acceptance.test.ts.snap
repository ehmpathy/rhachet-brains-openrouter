exports[`getBrainAtomsByOpenRouter.acceptance given: [case15] an effort with both a level and a budget when: [t0] it is asked then: the refusal a human reads matches snapshot 1`] = `
"✋ ConstraintError: invalid effort for openrouter/deepseek/flash: both level and budget; openrouter takes one
  got: effort = {"level":"low","budget":{"tokens":1000}}

valid shapes, one of:
  - effort: 'minimal' | 'low' | 'medium' | 'high'   (≡ { level: … })
  - effort: { budget: { tokens: N } }   N a positive integer"
`;

exports[`getBrainAtomsByOpenRouter.acceptance given: [case16] a latency sort under floor when: [t0] it is asked then: the refusal a human reads matches snapshot 1`] = `
"✋ ConstraintError: invalid openrouter supply filter 'sort=latency': the floor walk cannot order by latency

fix: let openrouter order by latency, with no floor —
  …/privacy=full&sort=latency   (a sort word alone keeps the default floor, so name a filter word)
or keep the floor, ordered by throughput —
  …/floor&sort=throughput

valid words, joined by '&' in any order:
  - floor
  - speed=min{N}tps · speed.min={N}tps
  - region=usa
  - precision=int4|int8|fp4|fp6|fp8|fp16|bf16|fp32
  - privacy=full
  - price.max={N}usd/M
  - sort=price|throughput|latency   (latency: only without floor)"
`;

