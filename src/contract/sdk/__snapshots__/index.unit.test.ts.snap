exports[`rhachet-brains-openrouter.unit given: [case2] genBrainAtom factory when: [t3] called with an invalid slug then: throws a ConstraintError that names both valid forms 1`] = `
"✋ ConstraintError: 'invalid/slug' names no openrouter model.

name one of these, each with an optional /{filters} segment:
  - a tier:
      openrouter/deepseek/pro
      openrouter/deepseek/flash
      openrouter/moonshotai/pro
      openrouter/z-ai/pro
      openrouter/z-ai/flash
  - any openrouter id: openrouter/{author}/{model}, e.g. openrouter/z-ai/glm-5.3

{
  "slug": "invalid/slug",
  "valid": [
    "openrouter/deepseek/pro",
    "openrouter/deepseek/flash",
    "openrouter/moonshotai/pro",
    "openrouter/z-ai/pro",
    "openrouter/z-ai/flash"
  ]
}"
`;
