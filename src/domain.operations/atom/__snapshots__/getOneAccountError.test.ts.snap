exports[`getOneAccountError given: [case1] openrouter answers 402 insufficient credits when: [t0] the error is classified then: the message matches snapshot 1`] = `
"✋ ConstraintError: openrouter has no credits left on this account. please add credits.

fix: top up at https://openrouter.ai/settings/credits
     (and raise the key's own credit limit, if it has one: https://openrouter.ai/settings/keys)

{
  "status": 402
}"
`;

exports[`getOneAccountError given: [case2] openrouter answers 401 for a bad key when: [t0] the error is classified then: the message matches snapshot 1`] = `
"✋ ConstraintError: openrouter rejected the OPENROUTER_API_KEY. please check the key.

fix: mint a key at https://openrouter.ai/settings/keys, then
     rhx keyrack fill --owner ehmpath --env <env> --key OPENROUTER_API_KEY --refresh

{
  "status": 401
}"
`;
