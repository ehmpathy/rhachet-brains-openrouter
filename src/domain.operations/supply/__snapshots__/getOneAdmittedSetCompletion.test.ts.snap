exports[`getOneAdmittedSetCompletion given: [case5] every host faults when: [t0] the set is sent then: the message matches snapshot 1`] = `
"💥 MalfunctionError: openrouter served no qualified endpoint of deepseek/deepseek-v4.1-flash: each was rate limited, refused, failed (mid-reply or with its own error), cut its body, stalled, or answered prose or 0 chars where json was owed. no answer was returned.

  throttled A
  failed    B
  refused   C

fix: retry after 7s (openrouter's retry-after), or loosen a promise so more endpoints qualify.

{
  "model": "deepseek/deepseek-v4.1-flash",
  "attempts": [
    {
      "tag": "A",
      "outcome": "throttled"
    },
    {
      "tag": "B",
      "outcome": "failed"
    },
    {
      "tag": "C",
      "outcome": "refused"
    }
  ],
  "retryAfter": "7",
  "faultReasonLast": null,
  "untried": 0,
  "bound": {
    "milliseconds": 50
  }
}"
`;

