exports[`getOneReplyDefectError a 200 body with an error in place of choices is refused, and quotes openrouter 1`] = `
"💥 MalfunctionError: openrouter returned no usable reply (finish_reason=none, 0 chars). the upstream provider likely failed mid-reply.
openrouter said: Provider returned error

fix: retry the ask. if it recurs, admit other providers via filters, or choose another model
audit: https://openrouter.ai/activity — generation gen-1, provider DeepInfra

{
  "defect": "failed",
  "finishReason": null,
  "provider": "DeepInfra",
  "generationId": "gen-1",
  "contentLength": 0,
  "tokensOutput": null,
  "tokensThought": null,
  "tokensThoughtBudget": null,
  "thoughtLevel": null,
  "errorMessage": "Provider returned error",
  "costUsd": null
}"
`;

exports[`getOneReplyDefectError a prose reply where json is owed is refused, and names the host 1`] = `
"💥 MalfunctionError: openrouter's host DeepInfra ignored the json schema asked for, and replied in plain text (21 chars). the reply is withheld.

fix: ask via a floor slug — the floor walk steps past a host that answers prose, and skips it for 7 days. or ask for z.string() and parse the reply yourself
audit: https://openrouter.ai/activity — generation gen-1, provider DeepInfra

{
  "defect": "prose",
  "finishReason": "stop",
  "provider": "DeepInfra",
  "generationId": "gen-1",
  "contentLength": 21,
  "tokensOutput": 0,
  "tokensThought": null,
  "tokensThoughtBudget": null,
  "thoughtLevel": null,
  "errorMessage": null,
  "costUsd": null
}"
`;

