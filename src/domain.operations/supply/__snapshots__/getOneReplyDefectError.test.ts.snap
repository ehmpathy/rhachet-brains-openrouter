exports[`getOneReplyDefectError an all-thought reply from a host with a vast output room suggests a capped budget, never the room 1`] = `
"💥 MalfunctionError: openrouter's host spent the whole reply on thought, and wrote no answer (383990 of 384000 output tokens were thought; finish_reason=length; 0 chars of answer).

fix: budget thought below the output room, so the answer has space —
  atom.ask({ ...input, effort: { budget: { tokens: 8000 } } })
audit: https://openrouter.ai/activity — generation gen-1, provider DeepInfra

{
  "defect": "all-thought",
  "finishReason": "length",
  "provider": "DeepInfra",
  "generationId": "gen-1",
