exports[`getOneCompletionWithinBound given: [case2] a host whose body ends mid-json when: [t0] the call runs then: the message a caller reads matches snapshot 1`] = `
"💥 HostFaultError: openrouter's host ended its reply body mid-json; no reply could be read

fix: add 'floor' to the slug's filters, so the walk steps past a faulted host, or retry

{
  "fault": "body-cut",
  "tags": [
    "alpha",
    "beta"
  ],
  "bound": {
    "milliseconds": 50
  },
  "hint": "a transport fault on one host; another host may serve"
}"
`;

exports[`getOneCompletionWithinBound given: [case3] a host that sends no whole body inside the bound when: [t0] the call runs then: the message a caller reads matches snapshot 1`] = `
"💥 HostFaultError: openrouter's host sent no whole reply inside 50ms

fix: add 'floor' to the slug's filters, so the walk steps past a dead host; if answers are slow rather than dead, cap thought (effort on the ask)

{
  "fault": "stalled",
  "tags": [
    "alpha",
    "beta"
  ],
  "bound": {
    "milliseconds": 50
  },
  "hint": "a dead host is bounded here; a slow answer is bounded by a thought cap (effort on the ask)"
}"
`;
