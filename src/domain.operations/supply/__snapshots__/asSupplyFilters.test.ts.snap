exports[`asSupplyFilters refuses: both speed forms at once 1`] = `
"✋ ConstraintError: invalid openrouter supply filter 'speed=min50tps&speed.min=50tps': 'speed' written twice

valid words, joined by '&' in any order:
  - floor
  - speed=min{N}tps · speed.min={N}tps
  - region=usa
  - precision=int4|int8|fp4|fp6|fp8|fp16|bf16|fp32
  - privacy=full
  - price.max={N}usd/M
  - sort=price|throughput|latency   (latency: only without floor)

{
  "word": "speed=min50tps&speed.min=50tps"
}"
`;

